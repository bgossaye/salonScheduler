# Rakie Booking deployment/cache rules
# HTML/runtime config must always be fresh; only hashed CRA assets are immutable.

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|env\.js|app-manifest\.json)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/booking/static/" RAKIE_BOOKING_HASHED_STATIC=1
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=RAKIE_BOOKING_HASHED_STATIC
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /booking/

  # Existing files/directories are served normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing assets must be real 404s. Never return index.html for JavaScript,
  # CSS, images, fonts, JSON, source maps, or other deployment assets.
  RewriteRule \.(?:js|css|map|json|png|jpg|jpeg|gif|svg|webp|woff|woff2|ico)$ - [R=404,L,NC]

  # Only extensionless React routes fall back to the app shell.
  RewriteRule ^ index.html [L]
</IfModule>
