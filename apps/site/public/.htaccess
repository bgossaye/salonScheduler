Options -Indexes

AddType application/json .json
AddType application/javascript .js

<IfModule mod_headers.c>
  # Only content-hashed site build output is immutable.
  SetEnvIf Request_URI "^/static/" RAKIE_SITE_HASHED_STATIC=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=RAKIE_SITE_HASHED_STATIC

  # Mutable deployment/runtime files must always revalidate from the server.
  <FilesMatch "^(index\.html|sw\.js|manifest\.json|env\.js)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Existing files/directories are served normally. /booking is a real deployed
  # directory and therefore passes through to its own .htaccess rules.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing asset requests must be true 404s, never the SPA HTML shell.
  RewriteRule \.(?:js|css|map|json|png|jpg|jpeg|gif|svg|webp|woff|woff2|ico)$ - [R=404,L,NC]

  # Site SPA routes only.
  RewriteRule . /index.html [L]
</IfModule>
